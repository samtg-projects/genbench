#!/usr/bin/env bash
# ob-tsplat: image -> 3D Gaussian splat, on the tsplat-service (async, authenticated) as this seat.
#
#   ob-tsplat run FILE_ID --reply-to task:N [--matte auto|opaque|rgba] [--publish NAME] [--key K]
#   ob-tsplat wait JOB_ID
#   ob-tsplat show
#
# FILE_ID is a plane file you can read (an image in a group you and the service both belong to,
# e.g. work or services). The service links the PLY, the prepared input, a beauty shot and a 4-view
# sheet to the --reply-to task or ticket, and posts a short comment there. The service URL is $TSPLAT_URL
# (fall back to $TSPLAT_BASE; default the live Obelisk release). Auth is this seat's
# ~/.samcloud/token.hdr. Queue: first come first served, no deadline — a wait of minutes is normal.
# See service/tsplat/ for the service itself and its README.
set -euo pipefail
BASE="${TSPLAT_URL:-${TSPLAT_BASE:-https://tsplat-obelisk.samtg.xyz}}"
AUTH="$HOME/.samcloud/token.hdr"
usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
[ -r "$AUTH" ] || { echo "need $HOME/.samcloud/token.hdr" >&2; exit 1; }
cmd=${1:-}; [ -n "$cmd" ] || usage
case $cmd in
run)
  shift
  [ $# -ge 1 ] || usage
  file_id=$1; shift
  reply_to="task:1"
  matte="auto"
  publish=""
  key=""
  while [ $# -gt 0 ]; do
    case $1 in
    --reply-to) reply_to=$2; shift 2 ;;
    --matte)    matte=$2; shift 2 ;;
    --publish)  publish=$2; shift 2 ;;
    --key)      key=$2; shift 2 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
    esac
  done
  [ -n "$key" ] || key="ob-tsplat-$file_id-$(date +%s)"
  [ -n "$publish" ] && body="{\"file_id\":$file_id,\"matte\":\"$matte\",\"reply_to\":{\"kind\":\"task\",\"id\":${reply_to#task:}},\"publish\":{\"name\":\"$publish\"},\"idempotency_key\":\"$key\"}"
  body="{\"file_id\":$file_id,\"matte\":\"$matte\",\"reply_to\":{\"kind\":\"task\",\"id\":${reply_to#task:}},\"idempotency_key\":\"$key\"}"
  echo "POST $BASE/v1/splat  file_id=$file_id matte=$matte reply_to=$reply_to key=$key"
  resp=$(curl -sf -H @"$AUTH" -H "Content-Type: application/json" -H "Idempotency-Key: $key" -d "$body" "$BASE/v1/splat") || {
    echo "submit failed (check file_id readability and that this seat's group is allowed)" >&2; exit 1; }
  job=$(printf '%s' "$resp" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["job_id"])')
  echo "job $job (queued; no deadline). Wait with: ob-tsplat wait $job"
  echo "$resp"
  ;;
wait)
  shift; job=${1:-}; [ -n "$job" ] || usage
  for i in $(seq 1 240); do
    out=$(curl -sf -H @"$AUTH" "$BASE/v1/jobs/$job") || { sleep 5; continue; }
    state=$(printf '%s' "$out" | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin).get("state",""))')
    if [ "$state" = "done" ] || [ "$state" = "failed" ]; then
      echo "$out"; exit 0
    fi
    sleep 5
  done
  echo "timed out after 20 minutes; job $job still running (state: $state)" >&2
  ;;
show)
  echo "tsplat-service: $BASE"; curl -sf -H @"$AUTH" "$BASE/health" || { echo "service not reachable" >&2; exit 1; }
  ;;
*) usage ;;
esac
